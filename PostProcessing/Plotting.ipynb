    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib\n",
    "import plot_utils as pltutils\n",
    "eV = 1.60218e-12\n",
    "traj = np.loadtxt('./../Code/trajectory.dat')\n",
    "parsec = 3.086e18\n",
    "zmin = np.min(traj[:,0])\n",
    "zmax = np.max(traj[:,0])"
   ]
  },
