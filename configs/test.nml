/

&run
  outdir = '../out/test'
  scriptdir = '.'
  Ns = 40
  numbins = 50
  dttFF_min = 1.d-6
  apertures_rg = 7.3d0, 26.d0, 65.d0, 195.d0, 650.d0, 3.5d5, 0.d0, 0.d0, 0.d0, 0.d0
  n_ap = 6
  sync_approx = 'full'
  JET_ = .true.
  CJ_ = .true.
  NE_calc = .true.
  Np_calc = .false.
  radsyn_calc = .true.
  radpsyn_calc = .false.
  radic_calc = .false.
  print_tlosses = .false.
  sort_outputs = .false.
  fix_norm_taper = .false.
  fix_inj_emin = .false.
/
