&model
  M_BH = 6.5d9
  dist_mpc = 16.8d0
  incl_deg = 17.d0
  gj0 = 1.01d0
  z0_rg = 50.d0
  zmax_rg = 1.2d6
  zmax_inj_rg = 1.d5
  r_br_rg = 46.d0
  z_br_rg = 140.d0
  z_acc_rg = 2.d2
  rin_0_rg = 0.d0
  geomIndex_out = 0.56d0
  geomIndex_in = 0.6d0
  LnTpFF = 1.d43
  facc = 1.d-2
  EminFF_eV = 1.d6
  Emin_injFF_eV = 2.d6
  EmaxFF_eV = 5.d15
  fnT = 1.d-1
  EpminFF_eV = 1.d9
  Epmin_injFF_eV = 2.d9
  EpmaxFF_eV = 1.d18
  p = 2.05d0
  Lj = 1.2d43
  sigma_0 = 100.d0
  a_inj = 0.01d0
